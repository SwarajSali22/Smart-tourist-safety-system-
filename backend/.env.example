# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/smart-tourist?retryWrites=true&w=majority

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── JWT (generate strong random secrets for production) ───────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ── bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Safety checks ────────────────────────────────────────────────────────────
SAFETY_CHECK_INTERVAL_MINUTES=25
SAFETY_CHECK_RESPONSE_WINDOW_MINUTES=5

# ── SMS alerts (optional; Twilio) ─────────────────────────────────────────────
# Leave blank to disable. Trial accounts can only text numbers verified in Twilio.
# Keep real values in backend/.env only (never commit it). TWILIO_FROM must be an E.164 number you own.
# Example: TWILIO_ACCOUNT_SID=AC..., TWILIO_AUTH_TOKEN=..., TWILIO_FROM=+15550001234
# (blank on purpose: copying this file must not enable SMS with fake credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Place search for Help Centers (admin) ─────────────────────────────────────
# Uses OpenStreetMap Nominatim. Its usage policy REQUIRES an identifying User-Agent
# (app name + contact). Without GEOCODE_USER_AGENT, place search is disabled and
# admins enter addresses/coordinates manually. Max 1 request/second is enforced server-side.
# For heavy use, point GEOCODE_BASE_URL at your own Nominatim instance or a hosted provider.
GEOCODE_USER_AGENT=
GEOCODE_EMAIL=
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
