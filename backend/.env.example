# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/smart-tourist?retryWrites=true&w=majority

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── JWT (generate strong random secrets for production) ───────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ── bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Safety checks ────────────────────────────────────────────────────────────
SAFETY_CHECK_INTERVAL_MINUTES=25
SAFETY_CHECK_RESPONSE_WINDOW_MINUTES=5

# ── SMS alerts (optional; Twilio) ─────────────────────────────────────────────
# Leave blank to disable. Trial accounts can only text numbers verified in Twilio.
# Keep real values in backend/.env only (never commit it). TWILIO_FROM must be an E.164 number you own.
# Example: TWILIO_ACCOUNT_SID=AC..., TWILIO_AUTH_TOKEN=..., TWILIO_FROM=+15550001234
# (blank on purpose: copying this file must not enable SMS with fake credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Place search for Help Centers (admin) ─────────────────────────────────────
# Uses OpenStreetMap Nominatim. Its usage policy REQUIRES an identifying User-Agent
# (app name + contact). Without GEOCODE_USER_AGENT, place search is disabled and
# admins enter addresses/coordinates manually. Max 1 request/second is enforced server-side.
# For heavy use, point GEOCODE_BASE_URL at your own Nominatim instance or a hosted provider.
GEOCODE_USER_AGENT=
GEOCODE_EMAIL=
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org

# ── AI Copilot (optional) ─────────────────────────────────────────────────────
# Uses the Google Gemini API FREE tier (no credit card, no billing). Get a key:
#   1. Sign in at https://aistudio.google.com with a Google account.
#   2. Open "Get API key" -> "Create API key" (let it create a NEW project; do NOT link a billing account).
#   3. Paste the key below. Keep it in backend/.env only (never commit it, never put it in client/.env).
# Your live limits (requests/min, tokens/min, requests/day) are shown at https://aistudio.google.com/rate-limit
# Leave blank to switch the Copilot off: the page then shows "AI unavailable" and everything else works as before.
# Note: on the free tier Google may use prompts to improve its products — do not paste secrets into the Copilot.
GEMINI_API_KEY=
# Free models, tried in order; each has its own free quota, so the next is used when one is exhausted.
# STS never falls back to a paid service. Run "node ../scripts/copilotCheck.js" to confirm these names work for your key.
COPILOT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Cost/abuse guards: maximum answer length (tokens) and questions per user per day.
COPILOT_MAX_OUTPUT_TOKENS=4096
COPILOT_DAILY_LIMIT=100
# Real nearby places come from OpenStreetMap (no key needed). These are shared public servers:
# comma-separated Overpass mirrors are tried in order; for production consider your own instance.
# OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter
# Walking / driving route estimates (OSRM-compatible). Public demo servers: best-effort, light use only.
# COPILOT_ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# COPILOT_ROUTING_DRIVING_URL=https://router.project-osrm.org
# Place-name lookups reuse GEOCODE_USER_AGENT above (set it so "near <place>" questions work).
